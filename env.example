# Broker API Credentials
# Never commit actual credentials to version control
# Copy this file to .env and fill in your actual API keys

# OANDA API (for forex trading)
# OANDA uses Bearer token authentication - only API key is needed
# Account ID will be auto-detected if not provided
OANDA_API_KEY=d9421b4a852a82d7e3d169937c043565-4072de3ba6a9b39c3a10c9a8eae147cd
OANDA_ACCOUNT_ID=  # Optional - will be auto-detected from API if not provided
OANDA_ENVIRONMENT=practice  # Options: 'practice' (for fxTrade Practice) or 'live' (for production)

# Alpaca API (for stocks and crypto trading)
ALPACA_API_KEY=PKKTCW2ZCXTJ7J6OW7VU45EZQC
ALPACA_API_SECRET=CUvtadgwy8XnBZDQvG24tMj6bpncCJTY9msUaao5FqXP
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2  # Use https://api.alpaca.markets for live

# OpenRouter API (for sentiment analysis - can use OpenAI, Anthropic, and other models)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=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
# You can also use OpenAI directly if preferred:
# OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data/trading.db  # For PostgreSQL: postgresql://user:pass@localhost/dbname

# Fundamental Data APIs (Optional)
# Alpha Vantage API (for stock fundamentals and news) - Get free key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# FRED API (for macro economic data) - Get free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# News APIs (for sentiment analysis)
# NewsAPI - Get free key from https://newsapi.org/register (100 requests/day free)
NEWSAPI_API_KEY=
# Note: CryptoCompare is free and doesn't require an API key

# Trading Mode
TRADING_MODE=paper  # Options: 'paper' or 'live'
ENABLE_LIVE_TRADING=false  # Additional safety flag

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/trading_agent.log

TF_ENABLE_ONEDNN_OPTS=0