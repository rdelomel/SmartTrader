# Broker API Credentials
# Never commit actual credentials to version control
# Copy this file to .env and fill in your actual API keys

# OANDA API (for forex trading)
# Get your API key from: https://www.oanda.com/eu-en/trading/demo-account/
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=  # Optional - will be auto-detected from API if not provided
OANDA_ENVIRONMENT=practice  # Options: 'practice' or 'live'

# Alpaca API (for stocks and crypto trading)
# Get your API key from: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2  # Use https://api.alpaca.markets for live

# Binance API (for crypto trading - better liquidity than Alpaca)
# Get your API key from: https://www.binance.com/en/my/settings/api-management
# Use Testnet for paper trading: https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true  # Set to false for live trading

# OpenRouter API (for sentiment analysis)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data/trading.db  # For PostgreSQL: postgresql://user:pass@localhost/dbname

# Fundamental Data APIs (Optional)
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# News APIs (for sentiment analysis)
NEWSAPI_API_KEY=

# Trading Mode
TRADING_MODE=paper  # Options: 'paper' or 'live'
ENABLE_LIVE_TRADING=false  # Additional safety flag

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/trading_agent.log

TF_ENABLE_ONEDNN_OPTS=0
